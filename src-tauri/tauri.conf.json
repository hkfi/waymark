{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waymark",
  "version": "0.1.5",
  "identifier": "com.waymark.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waymark",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 10,
          "y": 15
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QkJENzZBODc0QThFNDIKUldSQ2prcUhhdGU3aE8yZUp5MCt3RFIveHA3WVRuNzFvY0VHVkJ4WDcwWUErRkdPYk1NMGZ3ZnAK",
      "endpoints": [
        "https://github.com/hkfi/waymark/releases/latest/download/latest.json"
      ]
    }
  }
}
